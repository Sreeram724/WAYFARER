# Wayfarer Environment Configuration
PORT=3000
SESSION_SECRET=wayfarer-super-secret-key-change-in-production

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=wayfarer123

# Razorpay Payment Gateway (Leave blank for verified Sandbox/Demo simulator)
# RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyHere
# RAZORPAY_KEY_SECRET=YourRazorpaySecretHere

# Google Sign-In OAuth 2.0 (Google Identity Services)
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Email Confirmation (Nodemailer SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=notifications@wayfarer.travel
# SMTP_PASS=your-app-password

# MongoDB Database Connection
# Local MongoDB: mongodb://127.0.0.1:27017/wayfarer
# Or MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/wayfarer?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/wayfarer

